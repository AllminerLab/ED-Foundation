{
  "model_type": "beit3-ed-foundation",
  "architecture": "BEiT3EDFoundationModel",
  "vocab_size": 64010,
  "embed_dim": 768,
  "num_layers": 12,
  "num_heads": 12,
  "max_position_embeddings": 512,
  "hidden_dropout_prob": 0.1,
  "image_size": 224,
  "num_channels": 3,
  "training_strategy": "linear_probing",
  "encoder_frozen": true,
  
  "supported_task_types": [
    "early_triage",
    "prognosis_prediction", 
    "full_process_decision"
  ],
  
  "datasets": {
    "early_triage": {
      "SYSMH-S-Triage": {
        "description": "SYSMH South Campus Emergency Triage Dataset",
        "modality": "text_only",
        "task_type": "classification",
        "num_classes": 4,
        "class_names": ["Level 1", "Level 2", "Level 3", "Level 4"],
        "training_required": true,
        "language": "zh"
      },
      "MIMIC-IV-ED-Triage": {
        "description": "MIMIC-IV ED Triage Classification",
        "modality": "text_only",
        "task_type": "classification",
        "num_classes": 5,
        "class_names": ["Level 1", "Level 2", "Level 3", "Level 4", "Level 5"],
        "training_required": true,
        "language": "en"
      },
      "SYSMH-N-Triage": {
        "description": "SYSMH North Campus Emergency Triage (Zero-shot)",
        "modality": "text_only",
        "task_type": "classification",
        "num_classes": 4,
        "class_names": ["Level 1", "Level 2", "Level 3", "Level 4"],
        "training_required": false,
        "zero_shot": true,
        "base_model": "SYSMH-S-Triage",
        "language": "zh"
      },
      "GTCMH-Triage": {
        "description": "Guangdong TCM Hospital Emergency Triage (Zero-shot)",
        "modality": "text_only",
        "task_type": "classification",
        "num_classes": 4,
        "class_names": ["Level 1", "Level 2", "Level 3", "Level 4"],
        "training_required": false,
        "zero_shot": true,
        "base_model": "SYSMH-S-Triage",
        "language": "zh"
      }
    },
    
    "prognosis_prediction": {
      "SYSMH-ED-Outcome": {
        "description": "SYSMH ED Admission Prediction",
        "modality": "text_only",
        "task_type": "classification",
        "num_classes": 2,
        "class_names": ["Not admitted", "Admitted"],
        "training_required": true,
        "language": "zh"
      },
      "MIMIC-IV-ED-AMI": {
        "description": "MIMIC-IV ED In-Hospital Mortality Prediction (AMI patients)",
        "modality": "text_only",
        "task_type": "classification",
        "num_classes": 2,
        "class_names": ["Survival", "Mortality"],
        "training_required": true,
        "language": "en"
      },
      "MIMIC-IV-ED-Outcome": {
        "description": "MIMIC-IV ED Multi-task Outcome Prediction with ECG",
        "modality": "multimodal",
        "modalities": ["text", "ecg"],
        "training_required": true,
        "language": "en",
        "tasks": {
          "admission_prediction": {
            "task_type": "classification",
            "num_classes": 2,
            "class_names": ["Not admitted", "Admitted"]
          },
          "length_of_stay": {
            "task_type": "classification",
            "num_classes": 3,
            "class_names": ["Short stay", "Medium stay", "Long stay"]
          },
          "severity_scoring": {
            "task_type": "classification",
            "num_classes": 9,
            "class_names": ["Score 0", "Score 1", "Score 2", "Score 3", "Score 4", "Score 5", "Score 6", "Score 7", "Score 8"]
          }
        }
      }
    },
    
    "full_process_decision": {
      "MIMIC-IV-EXT-MDS-ED": {
        "description": "MIMIC-IV ED Multimodal Decision Support",
        "modality": "multimodal",
        "modalities": ["text", "cxr", "ecg"],
        "training_required": true,
        "language": "en",
        "tasks": {
          "mechanical_ventilation": {
            "task_type": "classification",
            "num_classes": 2,
            "class_names": ["No", "Yes"]
          },
          "icu_stay": {
            "task_type": "classification",
            "num_classes": 2,
            "class_names": ["No", "Yes"]
          },
          "mortality_7d": {
            "task_type": "classification",
            "num_classes": 2,
            "class_names": ["Survival", "Mortality"]
          },
          "mortality_28d": {
            "task_type": "classification",
            "num_classes": 2,
            "class_names": ["Survival", "Mortality"]
          }
        }
      },
      "SYSMH-ED-MD": {
        "description": "SYSMH ED Medical Decision Multi-task",
        "modality": "text_only",
        "training_required": true,
        "language": "zh",
        "tasks": {
          "imaging_exam": {
            "task_type": "classification",
            "num_classes": 2,
            "class_names": ["No", "Yes"],
            "description": "Imaging examination requirement"
          },
          "lab_tests": {
            "task_type": "classification",
            "num_classes": 2,
            "class_names": ["No", "Yes"],
            "description": "Laboratory tests requirement"
          },
          "observation": {
            "task_type": "classification",
            "num_classes": 2,
            "class_names": ["No", "Yes"],
            "description": "Observation requirement"
          },
          "specialist_consultation": {
            "task_type": "classification",
            "num_classes": 2,
            "class_names": ["No", "Yes"],
            "description": "Specialist consultation requirement"
          }
        }
      }
    }
  },
  
  "model_capabilities": {
    "text_encoding": true,
    "image_encoding": true,
    "multimodal_fusion": true,
    "linear_probing": true,
    "zero_shot_inference": true,
    "multi_task_learning": true
  },
  
  "training_info": {
    "base_model": "BEiT3",
    "pretraining_data": "MIMIC-IV-ED",
    "pretraining_epochs": 10,
    "encoder_frozen": true,
    "linear_probing_only": true
  },
  
  "torch_dtype": "float32",
  "transformers_version": "4.30.0"
}

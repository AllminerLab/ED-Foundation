{
  "study_design": {
    "type": "retrospective model development and multi-center validation",
    "ethics_approval": "SYSKY-2026-384-01",
    "deidentification": true,
    "prospective_intervention": false
  },
  "pretraining": {
    "architecture": "BEIT-3",
    "backbone_layers": 12,
    "hidden_dim": 768,
    "attention_heads": 12,
    "ffn_dim": 3072,
    "text_tokenizer": "BPE",
    "text_vocab_size": 50000,
    "max_text_tokens": 512,
    "image_size": 224,
    "patch_size": 16,
    "image_tokens": 196,
    "stage_1": {
      "objective": "masked modeling",
      "text_mask_ratio": 0.15,
      "text_masking": ["random", "short_span"],
      "visual_augmentations": ["rotation_pm_5_degrees", "brightness_contrast", "specaugment"],
      "losses": ["masked_image_mse", "masked_token_cross_entropy"],
      "optimizer": "AdamW",
      "betas": [0.9, 0.999],
      "weight_decay": 0.05,
      "initial_lr": 0.0001,
      "warmup_fraction": 0.05,
      "min_lr": 0.000001,
      "scheduler": "cosine",
      "batch_size": 2048,
      "precision": "fp16",
      "epochs": 4
    },
    "stage_2": {
      "objective": "cross_modal_contrastive_learning",
      "loss": "InfoNCE",
      "temperature_init": 0.07,
      "ema": true
    },
    "corpus_counts": {
      "image_text_pairs": 1057891,
      "pure_text_entries": 350079,
      "mimic_cxr_report_pairs": 215971,
      "mimic_ecg_report_pairs": 610613,
      "quilt_pathology_pairs": 100000,
      "ratic_ct_annotation_pairs": 4274,
      "sysmh_timeseries_spectrogram_pairs": 72684,
      "mimic_timeseries_spectrogram_pairs": 54349,
      "sysmh_pure_text_entries": 187401,
      "mimic_pure_text_entries": 162678
    }
  },
  "downstream_protocol": {
    "linear_probing_only": true,
    "freeze_backbone": true,
    "task_head": "single_linear_layer_from_cls",
    "multitask_head": "independent_binary_heads_from_shared_cls",
    "loss": "cross_entropy_with_class_weight_balancing",
    "seeds": [2026, 2027, 2028, 2029, 2030, 2031, 2032],
    "binary_threshold": 0.5,
    "multiclass_rule": "argmax",
    "calibration_bins_default": 10,
    "calibration_bins_small_test": 8,
    "small_test_threshold": 500,
    "non_urgent_cost_cny": 96
  },
  "datasets": {
    "SYSMH-S-Triage": {
      "task_family": "early_triage",
      "split": "8:1:1",
      "split_level": "patient",
      "classes": [1, 2, 3, 4],
      "zero_shot_target": false,
      "input_template": "triage_cn",
      "required_columns": ["patient_id", "chief_complaint", "age", "sex", "systolic_bp", "diastolic_bp", "temperature", "heart_rate", "respiratory_rate", "oxygen_saturation", "consciousness", "arrival_mode", "label"],
      "high_risk_labels": [1, 2],
      "primary_metric": "macro_f1",
      "secondary_metrics": ["high_risk_recall"]
    },
    "SYSMH-N-Triage": {
      "task_family": "early_triage",
      "split": "external_test_only",
      "split_level": "patient",
      "classes": [1, 2, 3, 4],
      "zero_shot_target": true,
      "source_task_head": "SYSMH-S-Triage",
      "input_template": "triage_cn",
      "required_columns": ["patient_id", "chief_complaint", "age", "sex", "systolic_bp", "diastolic_bp", "temperature", "heart_rate", "respiratory_rate", "oxygen_saturation", "consciousness", "arrival_mode", "label"],
      "high_risk_labels": [1, 2],
      "primary_metric": "macro_f1",
      "secondary_metrics": ["high_risk_recall"]
    },
    "GTCMH-Triage": {
      "task_family": "early_triage",
      "split": "external_test_only",
      "split_level": "patient",
      "classes": [1, 2, 3, 4],
      "zero_shot_target": true,
      "source_task_head": "SYSMH-S-Triage",
      "input_template": "triage_cn",
      "required_columns": ["patient_id", "chief_complaint", "age", "sex", "systolic_bp", "diastolic_bp", "temperature", "heart_rate", "respiratory_rate", "oxygen_saturation", "consciousness", "arrival_mode", "label"],
      "high_risk_labels": [1, 2],
      "primary_metric": "macro_f1",
      "secondary_metrics": ["high_risk_recall"]
    },
    "MIMIC-IV-ED-Triage": {
      "task_family": "early_triage",
      "split": "8:1:1",
      "split_level": "visit",
      "classes": [1, 2, 3, 4, 5],
      "zero_shot_target": false,
      "input_template": "triage_en",
      "required_columns": ["visit_id", "chief_complaint", "age", "sex", "systolic_bp", "diastolic_bp", "temperature", "heart_rate", "respiratory_rate", "oxygen_saturation", "pain_score", "arrival_mode", "label"],
      "high_risk_labels": [1, 2],
      "primary_metric": "macro_f1",
      "secondary_metrics": ["high_risk_recall"]
    },
    "SYSMH-ED-Outcome": {
      "task_family": "prognosis_prediction",
      "split": "7:1.5:1.5",
      "split_level": "patient",
      "classes": [0, 1],
      "positive_class": 1,
      "input_template": "clinical_text_cn",
      "required_columns": ["patient_id", "chief_complaint", "history_present_illness", "past_medical_history", "primary_diagnosis", "age", "sex", "systolic_bp", "diastolic_bp", "temperature", "heart_rate", "respiratory_rate", "oxygen_saturation", "blood_glucose", "weight", "height", "consciousness", "label"],
      "primary_metric": "f1",
      "secondary_metrics": ["sensitivity", "precision", "confusion_matrix", "ece"]
    },
    "MIMIC-IV-ED-AMI": {
      "task_family": "prognosis_prediction",
      "split": "8:1:1",
      "split_level": "patient",
      "classes": [0, 1],
      "positive_class": 1,
      "input_template": "clinical_text_en",
      "required_columns": ["patient_id", "text", "label"],
      "primary_metric": "f1",
      "secondary_metrics": ["sensitivity", "precision", "confusion_matrix", "ece"]
    },
    "MIMIC-IV-ED-Outcome": {
      "task_family": "prognosis_prediction",
      "split": "8:1:1",
      "split_level": "patient",
      "input_template": "clinical_text_en",
      "required_columns": ["patient_id", "text", "ecg_path", "admission_prediction", "length_of_stay", "severity_scoring"],
      "tasks": {
        "admission_prediction": {"classes": [0, 1], "positive_class": 1, "metric": "f1"},
        "length_of_stay": {"classes": [0, 1, 2], "metric": "macro_f1"},
        "severity_scoring": {"classes": [0, 1, 2, 3, 4, 5, 6, 7, 8], "metric": "macro_f1"}
      }
    },
    "SYSMH-ED-MD": {
      "task_family": "full_process_decision",
      "split": "7:1.5:1.5",
      "split_level": "patient",
      "input_template": "clinical_text_cn",
      "required_columns": ["patient_id", "chief_complaint", "history_present_illness", "past_medical_history", "primary_diagnosis", "age", "sex", "systolic_bp", "diastolic_bp", "temperature", "heart_rate", "respiratory_rate", "oxygen_saturation", "imaging_exam", "lab_tests", "observation", "specialist_consultation"],
      "tasks": {
        "imaging_exam": {"classes": [0, 1], "positive_class": 1, "metric": "f1"},
        "lab_tests": {"classes": [0, 1], "positive_class": 1, "metric": "f1"},
        "observation": {"classes": [0, 1], "positive_class": 1, "metric": "f1"},
        "specialist_consultation": {"classes": [0, 1], "positive_class": 1, "metric": "f1"}
      }
    },
    "MIMIC-IV-EXT-MDS-ED": {
      "task_family": "full_process_decision",
      "split": "8:1:1",
      "split_level": "patient",
      "input_window_hours": 1.5,
      "input_template": "clinical_text_en",
      "required_columns": ["patient_id", "text", "cxr_path", "ecg_path", "mechanical_ventilation", "icu_stay", "mortality_7d", "mortality_28d"],
      "exclusion_label": -999,
      "tasks": {
        "mechanical_ventilation": {"classes": [0, 1], "positive_class": 1, "metric": "f1"},
        "icu_stay": {"classes": [0, 1], "positive_class": 1, "metric": "f1"},
        "mortality_7d": {"classes": [0, 1], "positive_class": 1, "metric": "f1"},
        "mortality_28d": {"classes": [0, 1], "positive_class": 1, "metric": "f1"}
      }
    }
  }
}
